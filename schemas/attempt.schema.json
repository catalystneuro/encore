{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "One attempt at reproducing the claims of a target",
  "description": "Draft. To be revised after the pilot. An attempt is recorded whether or not it produced a working notebook.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "id",
    "dataset",
    "paper",
    "date",
    "provenance",
    "outcomes"
  ],
  "properties": {
    "schema_version": {
      "const": 2
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
    },
    "dataset": {
      "description": "The dataset the attempt tested: the archive and the dataset's identifier there.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "archive",
        "id",
        "version"
      ],
      "properties": {
        "archive": {
          "description": "The archive that holds the dataset, in lower case: dandi, ebrains, openneuro, dryad, zenodo, figshare and so on.",
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]*$"
        },
        "id": {
          "description": "The dataset's identifier in that archive, e.g. 000003 on DANDI.",
          "type": "string",
          "minLength": 1
        },
        "version": {
          "description": "The version the attempt read, e.g. 0.220127.0436, or draft.",
          "type": "string",
          "minLength": 1
        },
        "modified": {
          "description": "For a version that can still change, such as a draft, when the archive says it was last modified. A published version is fixed and needs none; it usually has a DOI instead.",
          "type": "string",
          "format": "date-time"
        },
        "doi": {
          "description": "The DOI of the version read, when it has one: an identifier that holds across archives.",
          "type": "string",
          "pattern": "^10\\.[0-9]{4,9}/.+$"
        }
      },
      "if": {
        "properties": {
          "archive": {
            "const": "dandi"
          }
        }
      },
      "then": {
        "properties": {
          "id": {
            "pattern": "^[0-9]{6}$"
          }
        }
      }
    },
    "paper": {
      "type": "string",
      "pattern": "^doi:10\\.[0-9]{4,9}/.+$"
    },
    "date": {
      "type": "string",
      "format": "date"
    },
    "entry": {
      "description": "The entry this attempt produced (its name), if any.",
      "type": "string"
    },
    "deprecated": {
      "description": "Set when the attempt no longer stands, for example because its claims were written without the paper's full text. The record is kept as it was; its outcomes are shown but not counted.",
      "type": "object",
      "additionalProperties": false,
      "required": ["date", "reason"],
      "properties": {
        "date": {"type": "string", "format": "date"},
        "reason": {"type": "string", "minLength": 1},
        "superseded_by": {"description": "The id of the attempt that replaces it, once there is one.", "type": "string"}
      }
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "accountable"
      ],
      "properties": {
        "kind": {
          "enum": [
            "agent",
            "person"
          ]
        },
        "accountable": {
          "description": "The person or organisation responsible for this attempt.",
          "type": "object",
          "additionalProperties": false,
          "required": [
            "name"
          ],
          "properties": {
            "name": {
              "type": "string"
            },
            "orcid": {
              "type": "string",
              "pattern": "^[0-9]{4}-[0-9]{4}-[0-9]{4}-[0-9]{3}[0-9X]$"
            },
            "ror": {
              "type": "string"
            }
          }
        },
        "agent": {
          "description": "Required when kind is agent.",
          "type": "object",
          "additionalProperties": false,
          "required": [
            "harness",
            "model",
            "protocol"
          ],
          "properties": {
            "harness": {
              "type": "string"
            },
            "model": {
              "type": "string"
            },
            "protocol": {
              "description": "Version of the reproduction protocol the agent followed.",
              "type": "string"
            }
          }
        },
        "runner": {
          "description": "Where the attempt was run: the platform, and the run that wrote this record. Its other runs (verification rounds, revisions) are linked from their transcripts.",
          "type": "object",
          "additionalProperties": false,
          "required": [
            "platform"
          ],
          "properties": {
            "platform": {
              "description": "The platform that ran it, e.g. GitHub Actions, or local for a person's machine.",
              "type": "string",
              "minLength": 1
            },
            "url": {
              "description": "The run that wrote the record, e.g. https://github.com/<owner>/<repo>/actions/runs/<id>.",
              "type": "string",
              "pattern": "^https://"
            }
          }
        }
      }
    },
    "outcomes": {
      "description": "One per claim attempted.",
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "claim",
          "outcome"
        ],
        "properties": {
          "claim": {
            "description": "Claim id from the target's claims file.",
            "type": "string"
          },
          "outcome": {
            "enum": [
              "reproduced",
              "partially_reproduced",
              "not_reproduced",
              "blocked"
            ],
            "description": "Describes the result, not the method: whether the effect the claim states was found. Differences in method from the paper go in `deviations`."
          },
          "blocked_by": {
            "description": "Required when outcome is blocked.",
            "enum": [
              "data_missing",
              "metadata_insufficient",
              "methods_underspecified",
              "data_unreadable",
              "too_large",
              "not_runnable",
              "other"
            ]
          },
          "notes": {
            "description": "What differs, or what was missing, stated factually.",
            "type": "string"
          },
          "notebook": {
            "description": "Path of the notebook within the entry.",
            "type": "string"
          },
          "output": {
            "description": "Which output shows the result, e.g. a cell tag.",
            "type": "string"
          },
          "measured": {
            "description": "The values obtained, for claims with expected values: one number, or one per expected value, in the same order.",
            "oneOf": [
              {
                "type": "number"
              },
              {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "number"
                }
              }
            ]
          },
          "deviations": {
            "description": "How the test differed from the paper's method or data, e.g. one session of four, or a substituted model.",
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "proposed": {
            "description": "A change of outcome found after the last verification round, held until a further round agrees with it.",
            "type": "object",
            "additionalProperties": false,
            "required": [
              "outcome",
              "reason"
            ],
            "properties": {
              "outcome": {
                "enum": [
                  "reproduced",
                  "partially_reproduced",
                  "not_reproduced",
                  "blocked"
                ]
              },
              "blocked_by": {
                "description": "Required when outcome is blocked.",
                "enum": [
                  "data_missing",
                  "metadata_insufficient",
                  "methods_underspecified",
                  "data_unreadable",
                  "too_large",
                  "not_runnable",
                  "other"
                ]
              },
              "reason": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        },
        "allOf": [
          {
            "if": {
              "properties": {
                "outcome": {
                  "const": "blocked"
                }
              }
            },
            "then": {
              "required": [
                "blocked_by",
                "notes"
              ]
            }
          }
        ]
      }
    },
    "verifications": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "date",
          "kind",
          "by",
          "results"
        ],
        "properties": {
          "date": {
            "type": "string",
            "format": "date"
          },
          "kind": {
            "enum": [
              "agent",
              "person",
              "paper_author"
            ]
          },
          "by": {
            "type": "string"
          },
          "results": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "claim",
                "agrees"
              ],
              "properties": {
                "claim": {
                  "type": "string"
                },
                "agrees": {
                  "type": "boolean"
                },
                "reason": {
                  "description": "The verifier's reason, in its own words.",
                  "type": "string"
                },
                "response": {
                  "description": "What the author changed or replied, kept apart from the verifier's reason.",
                  "type": "string"
                },
                "outcome": {
                  "description": "The outcome the verifier would give.",
                  "enum": [
                    "reproduced",
                    "partially_reproduced",
                    "not_reproduced",
                    "blocked"
                  ]
                }
              }
            }
          },
          "reviewed": {
            "description": "What was reviewed, e.g. a commit, when the attempt changed afterwards.",
            "type": "string"
          }
        }
      }
    },
    "findings": {
      "description": "What the attempt found about the dataset itself, whatever the outcomes. These roll up into the per-dataset report.",
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "kind",
          "statement"
        ],
        "properties": {
          "kind": {
            "enum": [
              "metadata_error",
              "data_missing",
              "identifier_missing",
              "metadata_insufficient",
              "selection_undocumented",
              "methods_unavailable",
              "format_error",
              "code_mismatch",
              "paper_inconsistency",
              "other"
            ]
          },
          "statement": {
            "type": "string",
            "minLength": 1
          },
          "found": {
            "description": "How the finding was found. Unset: by the attempt itself. `on_prompt`: by the reconcile step of a repeat attempt, which checked a finding of the earlier attempt that this one, made blind, did not report (docs/protocol.md, \"Repeat attempts\").",
            "enum": ["on_prompt"]
          }
        }
      }
    },
    "reconciliation": {
      "description": "A repeat attempt's comparison with the attempt before it, written by the reconcile step once this attempt, made blind, has been verified (docs/protocol.md, \"Repeat attempts\"). A finding of this attempt that no item of `findings` points at is new.",
      "type": "object",
      "additionalProperties": false,
      "required": ["earlier", "date", "blind", "findings"],
      "properties": {
        "earlier": {"description": "The id of the attempt compared with.", "type": "string"},
        "date": {"type": "string", "format": "date"},
        "blind": {"description": "Whether this attempt's author saw nothing of earlier attempts, from `tools/blind.sh audit` and its transcripts.", "type": "boolean"},
        "blind_note": {"description": "What the author saw of an earlier attempt, when `blind` is false.", "type": "string"},
        "findings": {
          "description": "One item per finding of the earlier attempt, in its order.",
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["finding", "status", "note"],
            "properties": {
              "finding": {"description": "The earlier finding's number in its record, from 1.", "type": "integer", "minimum": 1},
              "status": {"enum": ["fixed", "partly_fixed", "still_present", "not_checked"]},
              "now": {"description": "The number, from 1, of this attempt's finding that reports it, when it is still present or partly fixed.", "type": "integer", "minimum": 1},
              "note": {"type": "string", "minLength": 1}
            }
          }
        },
        "outcomes": {
          "description": "The claims tested by both attempts whose outcome differs.",
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["claim", "earlier", "note"],
            "properties": {
              "claim": {"type": "string"},
              "earlier": {"enum": ["reproduced", "partially_reproduced", "not_reproduced", "blocked"]},
              "note": {"type": "string", "minLength": 1}
            }
          }
        },
        "protocol": {"description": "When the protocol changed between the two attempts, what the changes did.", "type": "string"}
      }
    },
    "inputs": {
      "description": "Everything the attempt used that is not in the dataset.",
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "what",
          "source"
        ],
        "properties": {
          "what": {
            "type": "string",
            "minLength": 1
          },
          "source": {
            "description": "A DOI, or a repository URL with the commit read.",
            "type": "string",
            "minLength": 1
          }
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "provenance": {
            "properties": {
              "kind": {
                "const": "agent"
              }
            }
          }
        }
      },
      "then": {
        "properties": {
          "provenance": {
            "required": [
              "agent"
            ]
          }
        }
      }
    }
  ]
}
