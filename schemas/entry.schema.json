{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "An entry: a directory of notebooks with its metadata (entry.yaml)",
  "description": "Draft. To be revised after the pilot.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "name", "type", "title", "description", "license", "notebooks", "related"],
  "properties": {
    "schema_version": {"const": 1},
    "name": {
      "description": "Unique across the registry, and the name of the entry's directory.",
      "type": "string",
      "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$",
      "maxLength": 100
    },
    "type": {"enum": ["orientation", "reproduction", "analysis"]},
    "title": {"type": "string", "minLength": 1, "maxLength": 300},
    "description": {"type": "string", "minLength": 1},
    "license": {"description": "SPDX identifier.", "type": "string"},
    "notebooks": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path"],
        "properties": {
          "path": {"type": "string", "pattern": "\\.ipynb$"},
          "title": {"type": "string"},
          "runtime_minutes": {"description": "Roughly how long it takes to run.", "type": "integer", "minimum": 1}
        }
      }
    },
    "helpers": {
      "description": "Python modules in the entry that the notebooks import.",
      "type": "array",
      "items": {"type": "string", "pattern": "\\.py$"}
    },
    "related": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "relation"],
        "properties": {
          "id": {
            "description": "dandi:<id>[/<version>], doi:<doi>, or entry:<name>.",
            "type": "string",
            "pattern": "^(dandi:[0-9]{6}(/.+)?|doi:10\\.[0-9]{4,9}/.+|entry:[a-z0-9]+(-[a-z0-9]+)*)$"
          },
          "relation": {"enum": ["uses_data", "reproduces", "derived_from", "references"]}
        }
      }
    }
  }
}
